import argparse
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.interpolate import griddata
from scipy.ndimage import gaussian_filter


def plot_fire_heatmap(csv_path, output_path=None, grid_size=300, method="linear", sigma=3):
    df = pd.read_csv(csv_path)

    required_cols = {"latitude", "longitude", "fire_probability"}
    missing = required_cols - set(df.columns)
    if missing:
        raise ValueError(f"CSV is missing required columns: {missing}")

    df = df.dropna(subset=["latitude", "longitude", "fire_probability"])

    lat = df["latitude"].to_numpy()
    lon = df["longitude"].to_numpy()
    fire_prob = df["fire_probability"].to_numpy()

    lon_min, lon_max = lon.min(), lon.max()
    lat_min, lat_max = lat.min(), lat.max()

    grid_lon, grid_lat = np.mgrid[
        lon_min:lon_max:complex(grid_size),
        lat_min:lat_max:complex(grid_size)
    ]

    grid_fire = griddata(
        points=(lon, lat),
        values=fire_prob,
        xi=(grid_lon, grid_lat),
        method=method
    )

    # Fill holes first
    if np.isnan(grid_fire).any():
        grid_fire_nearest = griddata(
            points=(lon, lat),
            values=fire_prob,
            xi=(grid_lon, grid_lat),
            method="nearest"
        )
        grid_fire = np.where(np.isnan(grid_fire), grid_fire_nearest, grid_fire)

    # Smooth the surface
    grid_fire = gaussian_filter(grid_fire, sigma=sigma)

    plt.figure(figsize=(10, 8))
    heatmap = plt.pcolormesh(grid_lon, grid_lat, grid_fire, shading="auto")
    plt.colorbar(heatmap, label="Fire Probability")

    plt.scatter(lon, lat, s=20, edgecolors="black", linewidths=0.5)
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.title("Wildfire Prediction Heat Map")
    plt.tight_layout()

    if output_path:
        plt.savefig(output_path, dpi=300)
        print(f"Saved heat map to: {output_path}")
    else:
        plt.show()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("csv_path")
    parser.add_argument("--output", "-o")
    parser.add_argument("--grid-size", type=int, default=300)
    parser.add_argument("--method", choices=["linear", "nearest", "cubic"], default="linear")
    parser.add_argument("--sigma", type=float, default=3.0, help="Gaussian smoothing strength")

    args = parser.parse_args()

    plot_fire_heatmap(
        csv_path=args.csv_path,
        output_path=args.output,
        grid_size=args.grid_size,
        method=args.method,
        sigma=args.sigma,
    )


if __name__ == "__main__":
    main()